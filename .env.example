# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string used by the app, drizzle-kit and the ingest CLI.
DATABASE_URL="postgresql://user:password@host:5432/database"
# DATABASE_POOL_MAX=10
# DRIZZLE_LOG=true

# ── Market data ─────────────────────────────────────────────────────────────
# "fixture" (default, offline) or "tefas" (live import).
MARKET_DATA_PROVIDER="fixture"
# TEFAS_BASE_URL="https://tefasws.takasbank.com.tr/uga/fonbilgilendirme/portal/service"
# TEFAS_TIMEOUT_MS=20000
# TEFAS_MAX_RETRIES=3
# TEFAS_CONCURRENCY=3
# TEFAS_USER_AGENT="FondeksBot/1.0 (+https://fondeks.com; market data sync)"
# Logs one raw upstream row per endpoint — use on the first live run to
# confirm the field mapping in src/lib/market/tefas.ts.
# INGEST_LOG_SAMPLES=true

# ── Market indices ──────────────────────────────────────────────────────────
# USD/TRY and EUR/TRY come from TCMB's daily bulletin: free, official, no key.
# TCMB_BASE_URL="https://www.tcmb.gov.tr/kurlar"
#
# BIST 100/30, gram altın and gösterge faiz come from TCMB EVDS, which needs a
# free API key (https://evds2.tcmb.gov.tr). Without it those cards stay empty
# rather than showing invented numbers.
# TCMB_EVDS_API_KEY=""
# EVDS_BASE_URL="https://evds2.tcmb.gov.tr/service/evds"

# ── Fund holdings (artırılan / azaltılan pozisyonlar) ───────────────────────
# "fixture" (default, offline) or "kap" to read real filings.
#
# Under "kap" the monthly "Portföy Dağılım Raporu" each fund files is fetched
# from KAP and its section III holdings table is read out by Claude, so
# ANTHROPIC_API_KEY is required. Roughly one report per tracked fund per month.
HOLDINGS_PROVIDER="fixture"
# KAP_BASE_URL="https://www.kap.org.tr"
# KAP_TIMEOUT_MS=25000
# In-flight requests to KAP. It is a public disclosure site, not a data feed.
# KAP_CONCURRENCY=3
# Reports one submit pass will pay to extract; sized to fit a cron
# invocation. The submit cron runs daily through the filing window, so a large
# catalogue converges over a few days. Raise it for a CLI backfill.
# KAP_SUBMIT_LIMIT=200
# Reports one document pass will locate. Locating is one listing call and no
# download, so it stays ahead of extraction and keeps every filing re-readable:
# `yarn ingest reextract` runs a new extraction over the recorded documents
# without crawling KAP again.
# KAP_DOCUMENT_LIMIT=500
# Requests per Batch API submission. Bounded by the batch size limit, not count.
# KAP_EXTRACT_BATCH_SIZE=200
# Funds one launch-date pass will read. TEFAS publishes no launch date, so
# /api/cron/sync-inceptions reads each fund's KAP record until the catalogue is
# filled, then idles — a launch date is read once and never changes.
# KAP_INCEPTION_LIMIT=200
# KAP's fund directory is a single ~8MB page, so it gets its own ceiling.
# KAP_DIRECTORY_TIMEOUT_MS=90000

# ── Extraction ──────────────────────────────────────────────────────────────
# Reads holdings out of the KAP report PDFs. Only needed with HOLDINGS_PROVIDER
# set to "kap". Extraction goes through the Batch API, at half price.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MAX_RETRIES=3

# ── Scheduling ──────────────────────────────────────────────────────────────
# Shared secret for /api/cron/*. Vercel Cron sends it as a Bearer token.
# sync-positions submits a period's reports; collect-positions applies the
# batches once they end, and is what actually fills the movers.
CRON_SECRET="change-me"

# ── Search engine submission ────────────────────────────────────────────────
# /api/cron/submit-urls and `yarn submit-urls` announce the sitemap's URLs.
# Both providers are optional and independent: whichever is configured runs.
#
# IndexNow reaches Bing, Yandex, Seznam and Naver in one submission and accepts
# any URL. The key is 8-128 hex characters — `openssl rand -hex 16` — and is
# served back at /indexnow.txt, which is how the engines verify the host.
# INDEXNOW_KEY=""
#
# Google's Indexing API. Note the scope before relying on it: Google documents
# it as covering JobPosting and BroadcastEvent pages and does not crawl other
# URLs from it, so fund pages reach Google through the sitemap instead. The
# service account needs the "Owner" role on the property in Search Console.
# Paste the key file's private_key as-is; escaped newlines are handled.
# GOOGLE_INDEXING_CLIENT_EMAIL=""
# GOOGLE_INDEXING_PRIVATE_KEY=""
# Google's published defaults: 200 URLs a day, 600 requests a minute. A run
# takes the next slice of the catalogue, so a few thousand pages come round
# over a couple of weeks.
# GOOGLE_INDEXING_DAILY_QUOTA=200
# GOOGLE_INDEXING_RATE_LIMIT=600
