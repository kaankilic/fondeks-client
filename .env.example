# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string used by the app, drizzle-kit and the ingest CLI.
DATABASE_URL="postgresql://user:password@host:5432/database"
# DATABASE_POOL_MAX=10
# DRIZZLE_LOG=true

# ── Market data ─────────────────────────────────────────────────────────────
# "fixture" (default, offline) or "tefas" (live import).
MARKET_DATA_PROVIDER="fixture"
# TEFAS_BASE_URL="https://tefasws.takasbank.com.tr/uga/fonbilgilendirme/portal/service"
# TEFAS_TIMEOUT_MS=20000
# TEFAS_MAX_RETRIES=3
# TEFAS_CONCURRENCY=3
# TEFAS_USER_AGENT="FondeksBot/1.0 (+https://fondeks.com; market data sync)"
# Logs one raw upstream row per endpoint — use on the first live run to
# confirm the field mapping in src/lib/market/tefas.ts.
# INGEST_LOG_SAMPLES=true

# ── Market indices ──────────────────────────────────────────────────────────
# USD/TRY and EUR/TRY come from TCMB's daily bulletin: free, official, no key.
# TCMB_BASE_URL="https://www.tcmb.gov.tr/kurlar"
#
# BIST 100/30, gram altın and gösterge faiz come from TCMB EVDS, which needs a
# free API key (https://evds2.tcmb.gov.tr). Without it those cards stay empty
# rather than showing invented numbers.
# TCMB_EVDS_API_KEY=""
# EVDS_BASE_URL="https://evds2.tcmb.gov.tr/service/evds"

# ── Fund holdings (artırılan / azaltılan pozisyonlar) ───────────────────────
# "fixture" (default) or "kap" once the KAP endpoint is confirmed.
HOLDINGS_PROVIDER="fixture"
# KAP_BASE_URL="https://www.kap.org.tr"
# KAP_TIMEOUT_MS=25000

# ── Scheduling ──────────────────────────────────────────────────────────────
# Shared secret for /api/cron/*. Vercel Cron sends it as a Bearer token.
CRON_SECRET="change-me"
